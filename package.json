{
  "name": "forge",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "module": "src/main.tsx",
  "main": "dist/main.mjs",
  "author": "mateu",
  "scripts": {
    "dev": "bun run src/main.tsx",
    "typecheck": "tsc --noEmit",
    "electron:build": "bun build electron/main.ts --target node --format esm --external electron --outfile dist/main.mjs && bun build electron/preload.ts --target node --format cjs --external electron --outfile dist/preload.cjs",
    "electron:start": "bun run electron:build && electron .",
    "electron:package": "bun run electron:build && electron-builder --win portable",
    "electron:package:mac": "bun run electron:build && electron-builder --mac",
    "electron:install": "bun run electron:package:mac && cp -R \"release/mac-arm64/forge.app\" /Applications/ && xattr -dr com.apple.quarantine /Applications/forge.app && mdimport /Applications/forge.app"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "latest",
    "@ai-sdk/openai": "^4.0.71",
    "@ai-sdk/openai-compatible": "latest",
    "@ai-sdk/provider": "^4.0.17",
    "@opentui/core": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "ai": "latest",
    "solid-js": "1.9.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "typescript": "^5.8.0"
  },
  "build": {
    "appId": "dev.forge",
    "productName": "forge",
    "files": [
      "dist/**",
      "public/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    }
  }
}